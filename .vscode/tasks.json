{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MPI",
      "type": "shell",
      "command": "cl.exe",
      "args": [
        "/Zi",
        "/EHsc",
        "/nologo",
        "/I${env:MSMPI_INC}.",
        "/I${env:MSMPI_INC}x64",
        "${file}",
        "/link",
        "/LIBPATH:${env:MSMPI_LIB64}.",
        "msmpi.lib",
        "/OUT:${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
