{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MPI",
      "type": "process",
      "command": "${workspaceFolder}\\build_mpi.bat",
      "args": ["${file}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
